# Response headers for the Cloudflare deployment.
#
# These are the same directives the site carried in netlify.toml, moved to the
# `_headers` convention the static-assets layer reads. netlify.toml was
# Netlify-only and Cloudflare ignored it, so this file was always the one
# served - which is why the twin is gone now that every directive it carried
# lives here. This is the only copy: what is written here is the whole policy.
#
# Inline executable scripts and style elements are extracted into /scripts
# and /styles. Inline style attributes remain for generated chart/table
# geometry, so style-src-attr is the one deliberate exception. Data files ship
# with the site itself; connect-src stays self-only except for Web Push and
# Cloudflare's optional insights beacon.
#
# Cache-Control deliberately does not appear on /*: Cloudflare combines the
# headers of every matching block, so a broad no-cache rule here would be
# joined with the immutable asset rule below. HTML, assets and data get
# non-overlapping rules instead. The homepage and service-worker URLs are the
# exceptions: they must never be reused from an HTTP cache, so their narrower
# rules detach the broader HTML/asset Cache-Control values.
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store

/employer
  Cache-Control: no-store

/search-coverage
  X-Robots-Tag: noindex, follow
  Cache-Control: no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-cache

/404-internal
  Cache-Control: no-store
  X-Robots-Tag: noindex

/404-internal.html
  X-Robots-Tag: noindex

/build-info.json
  Cache-Control: no-store
  X-Robots-Tag: noindex

/*.html
  Cache-Control: no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-cache

/index.html
  ! Cache-Control
  ! CDN-Cache-Control
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

/manifest.json
  Cache-Control: no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-cache

/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store

/sitemap.xml
  Cache-Control: no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-cache

/robots.txt
  Cache-Control: no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-cache

/llms.txt
  Cache-Control: no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-cache

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self'; style-src-attr 'unsafe-inline'; style-src-elem 'self'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://fcm.googleapis.com https://cloudflareinsights.com; base-uri 'self'; form-action 'self' https://visa.vfsglobal.com; frame-ancestors 'none'; object-src 'none'

# Static assets are referenced with ?v=<build hash> in the built HTML/CSS.
# The hash changes whenever any of these files changes, so the URL can safely
# be cached for a year. The router applies the same policy to requests that
# reach the Pages Function rather than the assets layer.
/styles/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

# The registration script is part of the update path, not an immutable app
# asset. Detach the broad /scripts/* values before setting no-store.
/scripts/index-sw.js
  ! Cache-Control
  ! CDN-Cache-Control
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/analytics-chart.css
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/analytics-chart.js
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/pages.css
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/site-chrome.css
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/site-chrome.js
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

# Data files change with each scrape/deploy; never serve a stale decision list.
/data/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store
