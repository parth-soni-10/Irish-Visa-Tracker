# Response headers for the Cloudflare deployment.
#
# These are the same directives the site carried in netlify.toml, moved to the
# `_headers` convention the static-assets layer reads. netlify.toml was
# Netlify-only and Cloudflare ignored it, so this file was always the one
# served - which is why the twin is gone now that every directive it carried
# lives here. This is the only copy: what is written here is the whole policy.
#
# Inline executable scripts and style elements are extracted into /scripts
# and /styles. Inline style attributes remain for generated chart/table
# geometry, so style-src-attr is the one deliberate exception. Data files ship
# with the site itself; connect-src stays self-only except for Web Push and
# Cloudflare's optional insights beacon.
/employer
  Cache-Control: no-store

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self'; style-src-attr 'unsafe-inline'; style-src-elem 'self'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://fcm.googleapis.com https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
