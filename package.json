    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^6.5.438",
    "puppeteer": "^25.16.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0"
  }
