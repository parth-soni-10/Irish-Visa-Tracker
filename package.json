{
  "name": "irish-visa-tracker",
  "type": "module",
  "scripts": {
    "build": "node tools/site-chrome.mjs --check && node tools/deploy-pages.mjs",
    "chrome:sync": "node tools/site-chrome.mjs --write",
    "check:chrome": "node tools/site-chrome.mjs --check",
    "check:links": "node tools/check-links.mjs",
    "check:layout": "node tools/check-chrome-layout.mjs",
    "check:html": "python tools/check_html_scripts.py",
    "lint:css": "node tools/check-css.mjs",
    "lint:dead": "node tools/check-dead-code.mjs",
    "lint:js": "node tools/check-js-syntax.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tools/smoke-deploy.mjs",
    "rebuild:pages": "node tools/freshness.mjs --write && node tools/office-pages.mjs --write && node tools/insight-pages.mjs --write && node tools/growth-pages.mjs --write && node tools/daily-recent.mjs --write && node tools/monthly-pages.mjs --write && node tools/sitemap-lastmod.mjs --write",
    "monthly:pages": "node tools/monthly-pages.mjs --write",
    "social:cards": "node tools/social-cards.mjs --write",
    "seo:gsc": "node tools/search-console-review.mjs",
    "seo:indexnow": "node tools/indexnow.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:chrome": "playwright test chrome-tests.js",
    "test:e2e:webkit": "playwright test chrome-tests.js --project=\"Mobile Safari\"",
    "audit:a11y": "node accessibility-audit.js",
    "dev": "npx wrangler pages dev .",
    "deploy": "npm run build && npx wrangler pages deploy && npm run smoke",
    "audit:discovery": "node tools/audit-discovery.mjs",
    "audit:bots": "node tools/audit-search-bots.mjs",
    "audit:links": "node tools/link-reclamation.mjs",
    "audit:office": "node tools/office-analysis.mjs",
    "seo:sitemaps": "node tools/sitemap-index.mjs",
    "coverage:dashboard": "node tools/coverage-dashboard.mjs"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5",
    "pdf-poppler": "^0.2.3",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0",
    "web-push": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "playwright": "^1.65.0"
  }
}
