.freebuff/
__pycache__/
brag-output/

# Cloudflare Wrangler local state (not committed)
.wrangler/

# Raw Lighthouse reports are large and reproducible; only the trimmed record in
# perf/*.json and perf/BASELINE.md is committed.
perf/raw/

# Deploy staging output, written by tools/deploy-pages.mjs. Build output; also
# listed in .assetsignore, so it can never be uploaded even by hand.
.pages-dist/

# Local Wrangler secrets - never commit
.dev.vars
.dev.vars.*
.env
.env.*

# Local dependencies and generated build/test output
node_modules/
.functions-build/
test-functions/
playwright-report/
test-results/
/test-results.json

# Local logs and scratch output
*.log
/wrangler-output.txt
/build_log.txt
/log_output.txt

# Local browser state and downloaded OCR data
/cookies.txt
*.traineddata

# Debug screenshots
/*-debug.png
/*-check.png

# Ad-hoc root-level repair/check scripts
/debug_*.js
/check_*.py
/check_*.js
/fix_*.py
/add_*.py
/inline_*.py
/find_*.py
/find_*.js
/IMPLEMENT_ALL_GAPS.py
/test_final.py
/test_predict.js
/update_landing.py
/landing-page-update.js
